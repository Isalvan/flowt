rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla base: El usuario debe estar autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    match /movimientos/{movimiento} {
      // Permitir crear si es el dueño
      allow create: if isAuthenticated() && 
                      request.resource.data.id_propietario == request.auth.uid;
      
      // Permitir leer y actualizar si el documento pertenece al usuario (impidiendo transferir la propiedad)
      allow read: if isAuthenticated() && 
                     resource.data.id_propietario == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.id_propietario == request.auth.uid &&
                       request.resource.data.id_propietario == resource.data.id_propietario;
    }

    match /huchas/{hucha} {
      allow create: if isAuthenticated() && 
                      request.resource.data.id_propietario == request.auth.uid;
      
      // En update, verificamos que el dueño actual sea el que hace la petición (impidiendo transferir la propiedad)
      allow read: if isAuthenticated() && 
                     resource.data.id_propietario == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.id_propietario == request.auth.uid &&
                       request.resource.data.id_propietario == resource.data.id_propietario;
      
      // Permitir borrar al dueño
      allow delete: if isAuthenticated() && 
                        resource.data.id_propietario == request.auth.uid;
    }

    match /stats/{userId} {
      allow read, write: if isAuthenticated() && userId == request.auth.uid;
    }

    match /suscripciones/{suscripcion} {
      allow create: if isAuthenticated() &&
                      request.resource.data.id_propietario == request.auth.uid;

      allow read: if isAuthenticated() &&
                     resource.data.id_propietario == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.id_propietario == request.auth.uid &&
                       request.resource.data.id_propietario == resource.data.id_propietario;

      allow delete: if isAuthenticated() &&
                       resource.data.id_propietario == request.auth.uid;
    }

    match /correos_pendientes/{correo} {
      allow create: if isAuthenticated() && 
                      request.resource.data.id_propietario == request.auth.uid;
      
      allow read, delete: if isAuthenticated() && 
                             resource.data.id_propietario == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.id_propietario == request.auth.uid &&
                       request.resource.data.id_propietario == resource.data.id_propietario;
    }
  }
}