# Configuración Web de Firebase (obtener en Firebase Console -> Configuración del proyecto -> Tus aplicaciones)
# npm run setup crea .env.local con estos valores por ti.
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:1234567890abcdef

# URL del servicio de revisiones y del conector MCP (sin barra final).
# Vacía: la web no ofrece conexiones ni historial de revisiones.
VITE_REVIEW_API_URL=
