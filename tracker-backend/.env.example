# Remitente(s) bancarios (puede ser un único correo o varios separados por comas: alertas@unicaja.es, info@revolut.com)
BANK_SENDER=alertas@tu-banco.com

# UID único del usuario propietario en Firebase Auth
UID_PROPIETARIO=tu_uid_de_firebase

# Número máximo de correos sin leer a procesar por ejecución
MAX_EMAILS_PER_RUN=10

# Umbral mínimo de confianza (alta, media, baja)
MIN_CONFIDENCE=alta

# Modelo de IA de Google Gemini
AI_MODEL=gemini-1.5-flash

# Clave de API de Google Gemini (Google AI Studio)
GEMINI_API_KEY=tu_api_key_de_gemini

# Token secreto para validar llamadas al Webhook (Cloud Functions / Cloud Run)
WEBHOOK_TOKEN=generar_un_token_largo_y_seguro