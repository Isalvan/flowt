FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt requirements-review.in requirements.in ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-review.in
COPY reviews ./reviews
COPY finance ./finance
COPY prompts/categories.json ./prompts/categories.json
COPY mcp_server.py mcp_auth.py ./
ENV PORT=8080
USER 65532:65532
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers 2 --timeout 60 mcp_server:app"]
