rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers de Autenticación y Propiedad
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isOwner(resource.data.id_propietario);
    }
    
    function isReqOwner() {
      return isOwner(request.resource.data.id_propietario);
    }

    // Helpers de Tipos y Rangos
    function isNumber(field) {
      return request.resource.data.get(field, null) is number;
    }

    function isStringWithLength(field, min, max) {
      let val = request.resource.data.get(field, '');
      return val is string && val.size() >= min && val.size() <= max;
    }
    
    function isBool(field) {
      return request.resource.data.get(field, null) is bool;
    }

    function validCategoryValue(value) {
      return value is string && ((request.resource.data.tipo == 'gasto'
        ? value in ['alimentacion', 'vivienda', 'transporte', 'restaurantes', 'ocio', 'salud', 'compras', 'tecnologia', 'formacion', 'inversion', 'otros_gastos', 'sin_categorizar']
        : value in ['nomina', 'trabajos', 'ventas', 'intereses', 'regalos', 'reembolsos', 'otros_ingresos', 'sin_categorizar']) || validCustomCategory(value));
    }

    function validCustomCategory(value) {
      let path = /databases/$(database)/documents/categorias/$(request.auth.uid)/items/$(value);
      return isAuthenticated() && value.matches('custom_[a-f0-9]{64}') && exists(path) &&
        get(path).data.tipo in [request.resource.data.tipo, 'ambos'];
    }

    match /categorias/{userId}/items/{categoryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && categoryId.matches('custom_[a-f0-9]{64}') &&
        request.resource.data.keys().hasOnly(['label', 'tipo', 'created_at']) &&
        request.resource.data.keys().hasAll(['label', 'tipo', 'created_at']) &&
        isStringWithLength('label', 1, 50) &&
        request.resource.data.tipo in ['gasto', 'ingreso', 'ambos'] &&
        request.resource.data.created_at == request.time;
    }

    match /bancos/{userId}/items/{bancoId} {
      allow read, delete: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ancla_saldo', 'ancla_fecha', 'ultimo_desfase', 'updated_at']) &&
        request.resource.data.ancla_saldo is number &&
        request.resource.data.ancla_saldo >= -1000000 && request.resource.data.ancla_saldo <= 100000000 &&
        (request.resource.data.ultimo_desfase == null || request.resource.data.ultimo_desfase is number) &&
        request.resource.data.ancla_fecha == request.time;
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['nombre', 'created_at']) &&
        request.resource.data.keys().hasAll(['nombre', 'created_at']) &&
        isStringWithLength('nombre', 1, 40) &&
        request.resource.data.created_at == request.time;
    }

    function validMovementCategories() {
      return (!('categoria' in request.resource.data) || validCategoryValue(request.resource.data.categoria)) &&
        (!('categoria_sugerida' in request.resource.data) || validCategoryValue(request.resource.data.categoria_sugerida)) &&
        (!('categoria_confianza' in request.resource.data) || request.resource.data.categoria_confianza in ['alta', 'media', 'baja']) &&
        (!('compensaciones_descartadas' in request.resource.data) || (request.resource.data.compensaciones_descartadas is list && request.resource.data.compensaciones_descartadas.size() <= 200)) &&
        (!('review_protected_fields' in request.resource.data) || (request.resource.data.review_protected_fields is list &&
          request.resource.data.review_protected_fields.size() <= 4 &&
          request.resource.data.review_protected_fields.hasOnly(['concepto', 'categoria', 'hucha_id', 'suscripcion_id'])));
    }

    function protectsManualEdits() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let protected = request.resource.data.get('review_protected_fields', []);
      let provenance = resource.data.get('field_provenance', {});
      return protected.hasAll(resource.data.get('review_protected_fields', [])) &&
        (!('concepto' in provenance) || !changed.hasAny(['concepto']) || protected.hasAll(['concepto'])) &&
        (!('categoria' in provenance) || !changed.hasAny(['categoria']) || protected.hasAll(['categoria'])) &&
        (!('hucha_id' in provenance) || !changed.hasAny(['hucha_id']) || protected.hasAll(['hucha_id'])) &&
        (!('suscripcion_id' in provenance) || !changed.hasAny(['suscripcion_id']) || protected.hasAll(['suscripcion_id']));
    }

    match /movimientos/{movimiento} {
      allow create: if isReqOwner() && 
                       request.resource.data.keys().hasAll(['id_propietario', 'tipo', 'concepto', 'importe', 'fecha_operacion']) &&
                       request.resource.data.keys().hasOnly(['review_protected_fields', 'categoria', 'categoria_sugerida', 'categoria_confianza', 'compensaciones_descartadas', 'duplicados_descartados', 'id', 'id_propietario', 'tipo', 'concepto', 'importe', 'fecha_operacion', 'created_at', 'updated_at', 'hucha_id', 'compensado_por', 'compensado_por_detalles', 'compensa_movimiento_id', 'compensaciones_destinos', 'importe_neto', 'banco', 'cuenta_origen', 'id_correo_origen', 'suscripcion_id', 'es_metalico', 'es_interno', 'transfer_id']) &&
                       (request.resource.data.tipo == 'ingreso' || request.resource.data.tipo == 'gasto') &&
                       isNumber('importe') && request.resource.data.importe >= 0 &&
                       isStringWithLength('concepto', 0, 500) && validMovementCategories();
      
      allow read: if isDocOwner();
      allow update: if isDocOwner() && isReqOwner() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_protected_fields', 'categoria', 'categoria_sugerida', 'categoria_confianza', 'compensaciones_descartadas', 'duplicados_descartados', 'id', 'tipo', 'concepto', 'importe', 'fecha_operacion', 'updated_at', 'hucha_id', 'compensado_por', 'compensado_por_detalles', 'compensa_movimiento_id', 'compensaciones_destinos', 'importe_neto', 'banco', 'cuenta_origen', 'id_correo_origen', 'suscripcion_id', 'es_metalico', 'es_interno', 'transfer_id']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_propietario', 'created_at'])) &&
                       isNumber('importe') && request.resource.data.importe >= 0 &&
                       (request.resource.data.tipo == 'ingreso' || request.resource.data.tipo == 'gasto') &&
                       (!('concepto' in request.resource.data) || isStringWithLength('concepto', 0, 500)) && validMovementCategories() && protectsManualEdits();
      allow delete: if isDocOwner();
    }

    match /huchas/{hucha} {
      allow create: if isReqOwner() && 
                       request.resource.data.keys().hasAll(['id_propietario', 'nombre', 'tipo_aportacion', 'saldo_acumulado', 'es_principal', 'activa']) &&
                       request.resource.data.keys().hasOnly(['id', 'id_propietario', 'nombre', 'tipo_aportacion', 'valor_aportacion', 'saldo_acumulado', 'objetivo', 'orden', 'es_principal', 'es_suscripciones', 'es_metalico', 'es_interno', 'activa', 'tope_objetivo', 'subsanar_con', 'subsanar_hasta', 'deuda_pendiente', 'deuda_con', 'created_at', 'updated_at']) &&
                       isStringWithLength('nombre', 1, 100) &&
                       isNumber('saldo_acumulado') &&
                       (request.resource.data.tipo_aportacion in ['flat', 'porcentaje', 'resto']) &&
                       isBool('es_principal');
      
      allow read: if isDocOwner();
      allow update: if isDocOwner() && isReqOwner() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'nombre', 'tipo_aportacion', 'valor_aportacion', 'saldo_acumulado', 'objetivo', 'orden', 'es_principal', 'es_suscripciones', 'es_metalico', 'es_interno', 'activa', 'tope_objetivo', 'subsanar_con', 'subsanar_hasta', 'deuda_pendiente', 'deuda_con', 'updated_at']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_propietario', 'created_at'])) &&
                       isNumber('saldo_acumulado') &&
                       (!('tipo_aportacion' in request.resource.data) || request.resource.data.tipo_aportacion == null || request.resource.data.tipo_aportacion in ['flat', 'porcentaje', 'resto']) &&
                       (!('es_suscripciones' in resource.data) || resource.data.es_suscripciones == false || request.resource.data.keys().hasAll(['saldo_acumulado']));
      
      allow delete: if isDocOwner() && (!('es_suscripciones' in resource.data) || resource.data.es_suscripciones == false);
    }

    match /stats/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly(['total_ingresos', 'total_gastos', 'updated_at']);
      allow update: if isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_ingresos', 'total_gastos', 'updated_at']);
      allow delete: if false;
    }

    function validReviewMappingChange(userId) {
      let data = request.resource.data;
      let category = data.last_changed_category;
      let previous = resource == null ? {} : resource.data.category_huchas;
      let target = data.category_huchas.get(category, '__unassigned__');
      let huchaPath = /databases/$(database)/documents/huchas/$(target);
      let categoryPath = /databases/$(database)/documents/categorias/$(userId)/items/$(category);
      return data.keys().hasOnly(['category_huchas', 'revision', 'updated_at', 'last_changed_category']) &&
        data.keys().hasAll(['category_huchas', 'revision', 'updated_at', 'last_changed_category']) &&
        data.category_huchas is map && data.category_huchas.size() <= 200 &&
        category is string && category.size() > 0 && category.size() <= 100 &&
        data.category_huchas.diff(previous).affectedKeys().hasOnly([category]) &&
        data.revision is int && data.revision == (resource == null ? 1 : resource.data.revision + 1) &&
        data.updated_at == request.time &&
        ((!data.category_huchas.keys().hasAny([category])) || (target is string && target.size() > 0 && target.size() <= 200 &&
          (category in ['alimentacion', 'vivienda', 'transporte', 'restaurantes', 'ocio', 'salud', 'compras', 'tecnologia', 'formacion', 'inversion', 'otros_gastos', 'sin_categorizar'] ||
           (category.matches('custom_[a-f0-9]{64}') && exists(categoryPath) && get(categoryPath).data.tipo in ['gasto', 'ambos'])) &&
          exists(huchaPath) && get(huchaPath).data.id_propietario == userId && get(huchaPath).data.get('activa', true) == true &&
          get(huchaPath).data.get('es_metalico', false) == false && get(huchaPath).data.get('es_interno', false) == false));
    }

    match /review_configuration/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validReviewMappingChange(userId);
      allow delete: if false;
    }

    match /settings/{userId} {
      function validPreferences() {
        let data = request.resource.data;
        return (!('horas_semanales' in data) || data.horas_semanales == null ||
          (data.horas_semanales is number && data.horas_semanales >= 1 && data.horas_semanales <= 80)) &&
          (!('umbral_compra_pequena' in data) ||
          (data.umbral_compra_pequena is number && data.umbral_compra_pequena >= 1 && data.umbral_compra_pequena <= 100)) &&
          (!('inicio_periodo' in data) || data.inicio_periodo == 'nomina' ||
          (data.inicio_periodo is int && data.inicio_periodo >= 1 && data.inicio_periodo <= 28));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly(['tema', 'notificaciones', 'updated_at', 'divisa', 'pin_hash', 'pin_salt', 'horas_semanales', 'umbral_compra_pequena', 'inicio_periodo']) && validPreferences();
      allow update: if isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tema', 'notificaciones', 'updated_at', 'divisa', 'pin_hash', 'pin_salt', 'horas_semanales', 'umbral_compra_pequena', 'inicio_periodo']) && validPreferences();
      allow delete: if false;
    }

    match /suscripciones/{suscripcion} {
      allow create: if isReqOwner() &&
                       request.resource.data.keys().hasAll(['id_propietario', 'nombre', 'importe']) &&
                       request.resource.data.keys().hasOnly(['id', 'id_propietario', 'nombre', 'importe', 'frecuencia', 'fecha_inicio', 'dia_pago', 'fecha_proximo_pago', 'categoria', 'color', 'activa', 'cancelando', 'cancel_at', 'es_compartido', 'precio_original', 'participantes_count', 'mi_pago_calculado', 'mi_parte', 'hucha_id', 'created_at', 'updated_at', 'cancelada_en_servicio', 'fecha_cancelacion', 'banco']) &&
                       isStringWithLength('nombre', 1, 100) &&
                       isNumber('importe') && request.resource.data.importe >= 0;
      allow read: if isDocOwner();
      allow update: if isDocOwner() && isReqOwner() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'nombre', 'importe', 'frecuencia', 'fecha_inicio', 'dia_pago', 'fecha_proximo_pago', 'categoria', 'color', 'activa', 'cancelando', 'cancel_at', 'es_compartido', 'precio_original', 'participantes_count', 'mi_pago_calculado', 'mi_parte', 'hucha_id', 'updated_at', 'cancelada_en_servicio', 'fecha_cancelacion', 'banco']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_propietario', 'created_at'])) &&
                       isNumber('importe') && request.resource.data.importe >= 0;
      allow delete: if isDocOwner();
    }

    match /correos_pendientes/{correo} {
      allow read, delete: if isDocOwner();
      allow create, update: if false;
    }

    match /correos_historico/{correo} {
      allow read: if isDocOwner();
      allow create, update, delete: if false;
    }

    match /review_handoffs/{movementId} {
      allow create: if isReqOwner() &&
        request.resource.data.keys().hasOnly(['id_propietario', 'movement_id', 'email_id', 'created_at']) &&
        request.resource.data.movement_id == movementId &&
        request.resource.data.email_id is string &&
        request.resource.data.created_at == request.time &&
        getAfter(/databases/$(database)/documents/movimientos/$(movementId)).data.id_propietario == request.auth.uid &&
        getAfter(/databases/$(database)/documents/movimientos/$(movementId)).data.id_correo_origen == request.resource.data.email_id;
      allow read: if isDocOwner();
      allow update, delete: if false;
    }

    match /email_processing/{processingId} {
      allow read: if isDocOwner();
      allow write: if false;
    }
    match /review_jobs/{reviewId} {
      allow read: if isDocOwner();
      allow write: if false;
    }
    match /review_history/{reviewId} {
      allow read: if isDocOwner();
      allow write: if false;
    }
    match /review_questions/{questionId} {
      allow read: if isDocOwner();
      allow write: if false;
    }

    // Conector MCP: clientes, códigos, tokens y registro de operaciones.
    // Solo el servicio (Admin SDK) los lee o escribe; la web usa su API.
    match /oauth_clients/{clientId} { allow read, write: if false; }
    match /oauth_codes/{codeId} { allow read, write: if false; }
    match /oauth_grants/{grantId} { allow read, write: if false; }
    match /oauth_tokens/{tokenId} { allow read, write: if false; }
    match /mcp_operations/{operationId} { allow read, write: if false; }
  }
}
